<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="crew" name="Meet the crew"><mxGraphModel dx="1300" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="640" background="#0D1117" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;&lt;font style=&#x27;font-size:24px&#x27; color=&#x27;#E6EDF3&#x27;&gt;Meet the crew&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:13px&#x27; color=&#x27;#8B949E&#x27;&gt;one front door, four specialists, zero free-form shells&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="10" width="560" height="60" as="geometry"/></mxCell><mxCell id="me" value="&lt;font style=&#x27;font-size:40px&#x27;&gt;📱&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0D2238;strokeColor=#58A6FF;strokeWidth=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="100" height="100" as="geometry"/></mxCell><mxCell id="me_l" value="&lt;b&gt;Me&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#8B949E&#x27;&gt;one chat, anywhere&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;fontColor=#E6EDF3;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="140" height="40" as="geometry"/></mxCell><mxCell id="edith" value="&lt;font style=&#x27;font-size:56px&#x27;&gt;🕶️&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2A2410;strokeColor=#F2CC60;strokeWidth=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="270" y="250" width="150" height="150" as="geometry"/></mxCell><mxCell id="edith_n" value="&lt;b&gt;EDITH&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#F2CC60;strokeColor=none;fontColor=#1A1400;fontSize=15;" vertex="1" parent="1"><mxGeometry x="295" y="408" width="100" height="30" as="geometry"/></mxCell><mxCell id="edith_r" value="&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#8B949E&#x27;&gt;The orchestrator · Claude&lt;br&gt;plans, delegates, decides&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="245" y="440" width="200" height="40" as="geometry"/></mxCell><mxCell id="edith_q" value="“On it. Asking FRIDAY.”" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=14;position=0.3;base=16;fillColor=#2A2410;strokeColor=#F2CC60;fontColor=#F2CC60;fontStyle=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="235" y="175" width="150" height="45" as="geometry"/></mxCell><mxCell id="friday" value="&lt;font style=&#x27;font-size:40px&#x27;&gt;📊&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#10261A;strokeColor=#3FB950;strokeWidth=5;shadow=1;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="100" height="100" as="geometry"/></mxCell><mxCell id="friday_n" value="&lt;b&gt;FRIDAY&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#3FB950;strokeColor=none;fontColor=#0D1117;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="75" width="130" height="28" as="geometry"/></mxCell><mxCell id="friday_r" value="&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#C9D1D9&#x27;&gt;Health sentinel · read-only&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="106" width="200" height="20" as="geometry"/></mxCell><mxCell id="friday_q" value="&lt;i&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#3FB950&#x27;&gt;“All systems green. Disk is at 61%.”&lt;/font&gt;&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="128" width="220" height="30" as="geometry"/></mxCell><mxCell id="veronica" value="&lt;font style=&#x27;font-size:40px&#x27;&gt;🎬&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#251838;strokeColor=#BC8CFF;strokeWidth=5;shadow=1;" vertex="1" parent="1"><mxGeometry x="600" y="205" width="100" height="100" as="geometry"/></mxCell><mxCell id="veronica_n" value="&lt;b&gt;VERONICA&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#BC8CFF;strokeColor=none;fontColor=#0D1117;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="210" width="130" height="28" as="geometry"/></mxCell><mxCell id="veronica_r" value="&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#C9D1D9&#x27;&gt;Media pipeline operator&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="241" width="200" height="20" as="geometry"/></mxCell><mxCell id="veronica_q" value="&lt;i&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#BC8CFF&#x27;&gt;“Library is quiet. Nothing stuck.”&lt;/font&gt;&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="263" width="220" height="30" as="geometry"/></mxCell><mxCell id="jarvis" value="&lt;font style=&#x27;font-size:40px&#x27;&gt;🛡️&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2B1C0F;strokeColor=#F0883E;strokeWidth=5;shadow=1;" vertex="1" parent="1"><mxGeometry x="600" y="340" width="100" height="100" as="geometry"/></mxCell><mxCell id="jarvis_n" value="&lt;b&gt;JARVIS&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#F0883E;strokeColor=none;fontColor=#0D1117;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="345" width="130" height="28" as="geometry"/></mxCell><mxCell id="jarvis_r" value="&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#C9D1D9&#x27;&gt;Identity &amp; access&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="376" width="200" height="20" as="geometry"/></mxCell><mxCell id="jarvis_q" value="&lt;i&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#F0883E&#x27;&gt;“Shall I create the account, sir?”&lt;/font&gt;&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="398" width="220" height="30" as="geometry"/></mxCell><mxCell id="dume" value="&lt;font style=&#x27;font-size:40px&#x27;&gt;🦾&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E1616;strokeColor=#FF7B72;strokeWidth=5;shadow=1;" vertex="1" parent="1"><mxGeometry x="600" y="475" width="100" height="100" as="geometry"/></mxCell><mxCell id="dume_n" value="&lt;b&gt;DUM-E&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#FF7B72;strokeColor=none;fontColor=#0D1117;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="480" width="130" height="28" as="geometry"/></mxCell><mxCell id="dume_r" value="&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#C9D1D9&#x27;&gt;The builder · enabled &amp; working&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="511" width="200" height="20" as="geometry"/></mxCell><mxCell id="dume_q" value="&lt;i&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#FF7B72&#x27;&gt;“Build done. *happy beep*”&lt;/font&gt;&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="533" width="220" height="30" as="geometry"/></mxCell><mxCell id="tools" value="&lt;font style=&#x27;font-size:26px&#x27;&gt;🔒&lt;/font&gt;&lt;br&gt;&lt;b&gt;Safe toolbox&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#8B949E&#x27;&gt;approved commands only&lt;br&gt;no free-form shell&lt;br&gt;secrets never shown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1117;strokeColor=#30363D;strokeWidth=2;dashed=1;fontColor=#E6EDF3;arcSize=8;" vertex="1" parent="1"><mxGeometry x="960" y="215" width="150" height="190" as="geometry"/></mxCell><mxCell id="lab" value="&lt;font style=&#x27;font-size:40px&#x27;&gt;🏠&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#161B22;strokeColor=#8B949E;strokeWidth=4;shadow=1;" vertex="1" parent="1"><mxGeometry x="1150" y="260" width="100" he